---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const featuredProjects = [
  {
    title: "MergeLens",
    category: "Autonomous AI Code Review",
    timeframe: "Project",
    description: "Architected an AI-powered pull request review platform that analyzes GitHub PRs using a multi-agent LangGraph workflow. Built a high-performance native C++ static analysis engine leveraging Tree-sitter to extract AST structures, significantly reducing LLM token usage while improving review accuracy. Developed a Flutter web dashboard with Supabase-backed real-time monitoring.",
    techStack: ["Python", "FastAPI", "LangGraph", "C++", "Flutter", "Redis"],
    links: [
      { text: "Live Demo", url: "#" }
    ],
  },
  {
    title: "Filey",
    category: "Custom Binary File Format",
    timeframe: "Project",
    description: "Designed a custom C++ binary file format for a graph-structured mind map and published the package on the Arch User Repository (AUR). Built a cross-platform visual editor using Flutter to provide intuitive file interaction, ensuring data integrity through real-time rendering logic.",
    techStack: ["C++", "Flutter", "Docker"],
    links: [
      { text: "Live Demo", url: "#" }
    ],
  },
  {
    title: "Cricdle",
    category: "Cricketer Guessing Game",
    timeframe: "Project",
    description: "Architected a high-traffic cricket guessing game, managing a dynamic database of 3,000+ ESPN player profiles for instant, accurate validation. Implemented a hybrid caching strategy to ensure sub-millisecond response times, efficiently integrating external APIs to minimize latency and load overhead.",
    techStack: ["JavaScript", "Node.js", "Express", "Docker"],
    links: [
      { text: "Live Demo", url: "#" }
    ],
  },
  {
    title: "LinuxProxy",
    category: "System Tool",
    timeframe: "Project",
    description: "Automated system-wide proxy configuration on Linux using Bash, reducing manual setup across terminal-based tools. Configured environment variables and default CLI utilities to ensure consistent network behavior across applications.",
    techStack: ["Bash", "Linux"],
    links: [
      { text: "GitHub", url: "#" }
    ],
  },
  {
    title: "Attend",
    category: "QR-Based Attendance Platform",
    timeframe: "Project",
    description: "Developed a Flutter-based attendance application enabling teachers to manage classes and generate QR codes. Implemented QR-based student check-ins with Firestore-backed storage for real-time attendance recording.",
    techStack: ["Flutter", "Firebase", "Firestore"],
    links: [
      { text: "GitHub", url: "#" }
    ],
  }
];

const achievements = [
  {
    title: "Competitive Programming",
    category: "Contests",
    items: [
      "Secured Rank 8 in the CodeRed Finals at Aproksha '26 (500+ participants).",
      "Secured Rank 190 in Codeforces Round 1081 (Div. 2) (13,000+ participants).",
      "Secured Rank 695 in Pinely Round 5 (Div. 2) (8,500+ participants)."
    ]
  },
  {
    title: "Problem Solving",
    category: "Algorithms",
    items: [
      "Solved 400+ algorithmic problems across LeetCode and Codeforces.",
      "Focus on data structures and competitive programming patterns."
    ]
  },
  {
    title: "Project Management",
    category: "Leadership",
    items: [
      "Led development and version control for a cross-platform Flutter application during OpenCode '25.",
      "Reviewed 130+ pull requests and coordinated contributions from multiple developers using GitHub."
    ]
  }
];
---

<Layout title="Surya Raghuram — Work">
  <section class="max-w-5xl mx-auto mt-8 px-4 md:px-8 pb-8">
    
    <!-- Hero / Title -->
    <div class="mb-16 border-b border-white/10 pb-8 fade-in">
      <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight text-white leading-none mb-6">
        MY WORK.
      </h1>
      <p class="font-mono text-lg md:text-xl text-white/60 max-w-2xl leading-relaxed">
        Building high-performance tools, autonomous systems, and full-stack applications.
      </p>
    </div>

    <!-- Projects Section -->
    <div class="mb-24 fade-in" style="animation-delay: 0.1s;">
      <div class="mb-12 flex items-center gap-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16L12 22L22 16M2 12L12 18L22 12M2 8L12 14L22 8L12 2L2 8Z"></path></svg>
          PROJECTS
        </h2>
        <div class="h-[1px] flex-1 bg-gradient-to-r from-[var(--color-cyan)]/50 to-transparent"></div>
      </div>

      <div class="grid grid-cols-1 gap-8">
        {
          featuredProjects.map((item) => (
            <article class="neo-panel p-8 md:p-10 flex flex-col lg:flex-row gap-8 lg:gap-12 group min-h-[450px] lg:min-h-[350px]">
              
              <!-- Left Column: Title, Tags & Tech Stack -->
              <div class="lg:w-2/5 flex flex-col gap-4">
                <div class="flex flex-wrap gap-2 mb-2">
                  <span class="neo-tag neo-tag--cyan">
                    {item.category}
                  </span>
                  <span class="neo-tag neo-tag--pink">
                    {item.timeframe}
                  </span>
                </div>
                <h3 class="text-3xl md:text-4xl font-black tracking-tight text-white leading-tight group-hover:text-[var(--color-cyan)] transition-colors">
                  {item.title}
                </h3>

                {item.techStack && (
                  <div class="flex flex-wrap gap-2 mt-4 mb-2">
                    {item.techStack.map((tech) => (
                      <span class="font-mono text-[10px] font-bold text-white/70 px-2 py-1 bg-white/5 border border-white/10 rounded uppercase">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Right Column: Content & Links -->
              <div class="lg:w-3/5 flex flex-col h-full min-h-[200px]">
                <p class="font-mono text-base md:text-lg leading-relaxed text-white/70">
                  {item.description}
                </p>
                {item.links && item.links.length > 0 && (
                  <div class="flex flex-wrap gap-4 mt-auto pt-8">
                    {item.links.map(link => (
                      <a
                        href={link.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="neo-btn text-xs px-5 py-2.5 flex items-center gap-2"
                      >
                        {link.text}
                        {link.text.toLowerCase().includes('github') ? (
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
                          </svg>
                        ) : (
                          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                            <polyline points="15 3 21 3 21 9" />
                            <line x1="10" y1="14" x2="21" y2="3" />
                          </svg>
                        )}
                      </a>
                    ))}
                  </div>
                )}
              </div>
              
            </article>
          ))
        }
      </div>
    </div>

    <!-- Achievements Section -->
    <div class="fade-in" style="animation-delay: 0.2s;">
      <div class="mb-12 flex items-center gap-4">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--color-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
          ACHIEVEMENTS
        </h2>
        <div class="h-[1px] flex-1 bg-gradient-to-r from-[var(--color-purple)]/50 to-transparent"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 w-full">
        {achievements.map(ach => (
          <article class="neo-panel p-6 flex flex-col gap-4 group min-h-[300px]">
            <div class="flex items-start justify-between">
              <h3 class="text-xl font-black text-white group-hover:text-[var(--color-purple)] transition-colors">{ach.title}</h3>
              <span class="neo-tag neo-tag--purple text-[10px] bg-white/5 border-white/10 text-[var(--color-purple)] px-2 py-0.5">{ach.category}</span>
            </div>
            <ul class="font-mono text-sm leading-relaxed text-white/70 space-y-3 list-disc pl-4 mt-2">
              {ach.items.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>

  </section>
</Layout>
