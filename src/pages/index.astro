---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { Image } from 'astro:assets';
import placeholderImg from '../assets/placeholder.png';
---

<Layout title="Surya Raghuram — Software Developer">
  <!-- ═══════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════ -->
  <section class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-20 md:mb-32 items-center fade-in">
    <div class="flex flex-col items-start text-left">
      <span class="neo-tag mb-6">SOFTWARE DEVELOPER</span>
      <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tight leading-none mb-6">HELLO<br/>WORLD!</h1>
      
      <div class="font-mono text-base md:text-lg leading-relaxed mb-8 max-w-lg text-white/80 neo-box p-5 bg-black/40 border-l-4 border-l-[var(--color-cyan)] min-h-[220px]">
        <div class="flex items-center gap-2 mb-3 text-sm md:text-base font-bold">
          <span class="text-[var(--color-cyan)]">surya@portfolio</span>
          <span class="text-white/50">~ %</span>
          <span class="text-white">cat bio.json</span>
          <span class="w-2 h-4 bg-[var(--color-cyan)] animate-pulse"></span>
        </div>
        <div class="text-sm md:text-base text-white/70 pl-4 border-l border-white/10 ml-2 font-light">
          <span class="text-[var(--color-purple)]">"role"</span>: <span class="text-[var(--color-emerald)]">"IT Undergrad @ IIIT Allahabad"</span>,<br/>
          <span class="text-[var(--color-purple)]">"builds"</span>: [<span class="text-[var(--color-emerald)]">"Native Engines"</span>, <span class="text-[var(--color-emerald)]">"Full-Stack Apps"</span>, <span class="text-[var(--color-emerald)]">"AI Systems"</span>],<br/>
          <span class="text-[var(--color-purple)]">"mission"</span>: <span class="text-[var(--color-emerald)]">"Pushing limits of speed & usability"</span>
        </div>
      </div>
      
      <div class="flex flex-wrap gap-4">
        <a href="/work" class="neo-btn neo-btn--yellow text-sm md:text-base">VIEW MY WORK</a>
      </div>
    </div>
    
    <div class="neo-panel w-full h-[320px] md:h-[420px] relative p-2" id="hero-image-container">
      <div class="absolute inset-0 bg-gradient-to-tr from-[var(--color-cyan)]/20 to-[var(--color-purple)]/20 z-10 pointer-events-none rounded-[24px]"></div>
      <Image 
        src={placeholderImg} 
        alt="Abstract Neon Tech" 
        class="w-full h-full object-cover rounded-[20px] transition-transform duration-700 ease-out hover:scale-[1.03]"
      />
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       EXPERIENCE & SKILLS
       ═══════════════════════════════════════════════ -->
  <section class="mb-20 md:mb-32 fade-in">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      <!-- Experience Column -->
      <div class="flex flex-col gap-6">
        <h2 class="text-2xl md:text-3xl font-black mb-4 uppercase tracking-tight text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-cyan)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
          EXPERIENCE
        </h2>
        <div class="space-y-6 fade-in" style="animation-delay: 0.1s;">
        <div class="neo-box p-6 md:p-8 flex flex-col gap-4 min-h-[250px]">
          <div class="flex flex-wrap justify-between items-start gap-2 border-b border-white/10 pb-4">
            <div>
              <h3 class="text-xl font-bold text-[var(--color-cyan)]">GeekHaven, IIIT Allahabad</h3>
              <p class="font-mono text-sm text-white/60 mt-1">App Development Wing Mentor</p>
            </div>
            <span class="font-mono text-xs bg-white/10 px-3 py-1 rounded-full border border-white/20">Sep 2025 – Present</span>
          </div>
          <ul class="font-mono text-sm leading-relaxed text-white/80 space-y-3 mt-2 list-disc pl-4">
            <li><strong class="text-white">Technical Mentorship:</strong> Mentored participants during OpenCode '25, providing guidance on app development, debugging, and best practices.</li>
            <li><strong class="text-white">Project Management:</strong> Managed Git-based workflows, conducted technical PR reviews, and ensured code quality across projects.</li>
            <li><strong class="text-white">NomMetric:</strong> Supervised the development of NomMetric (Flutter, Firebase, Riverpod) by defining technical tasks and overseeing contributions.</li>
          </ul>
        </div>
      </div>

      <!-- Skills Column -->
      <div class="flex flex-col gap-6">
        <h2 class="text-2xl md:text-3xl font-black mb-4 uppercase tracking-tight text-white flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-purple)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          SKILLS
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 h-full">
          <!-- Languages -->
          <div class="neo-box p-5">
            <h3 class="font-mono text-xs font-bold text-white/50 tracking-wider mb-3">LANGUAGES</h3>
            <div class="flex flex-wrap gap-2">
              {['C/C++', 'Python', 'Dart', 'Java', 'JavaScript', 'SQL'].map((skill) => (
                <span class="font-mono text-xs bg-white/5 border border-white/10 px-2.5 py-1 rounded-md text-[var(--color-cyan)]">{skill}</span>
              ))}
            </div>
          </div>
          
          <!-- Frameworks -->
          <div class="neo-box p-5">
            <h3 class="font-mono text-xs font-bold text-white/50 tracking-wider mb-3">FRAMEWORKS</h3>
            <div class="flex flex-wrap gap-2">
              {['LangGraph', 'PyTorch', 'Flutter', 'React', 'FastAPI', 'Docker'].map((skill) => (
                <span class="font-mono text-xs bg-white/5 border border-white/10 px-2.5 py-1 rounded-md text-[var(--color-purple)]">{skill}</span>
              ))}
            </div>
          </div>
          
          <!-- Concepts -->
          <div class="neo-box p-5 md:col-span-2">
            <h3 class="font-mono text-xs font-bold text-white/50 tracking-wider mb-3">CONCEPTS & TOOLS</h3>
            <div class="flex flex-wrap gap-2">
              {['Data Structures', 'Algorithms', 'Computer Networks', 'Linux', 'Bash', 'Git', 'Blender', 'Unity'].map((skill) => (
                <span class="font-mono text-xs bg-white/5 border border-white/10 px-2.5 py-1 rounded-md text-[var(--color-emerald)]">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
