---
import linkPreview from '../assets/link_preview.png';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}

const {
  title = 'Durga Surya Raghuram Gadepalli',
  description = 'My digital portfolio and projects.',
  image,
  type = 'website',
} = Astro.props;

const navLinks = [
  { label: 'HOME', href: '/' },
  { label: 'WORK', href: '/work' },
];

const currentPath = Astro.url.pathname;

// Generate canonical URL and absolute image URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const resolvedImageURL = new URL(image ?? linkPreview.src, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Durga Surya Raghuram Gadepalli" />
    <meta name="theme-color" content="#050505" id="theme-color-meta" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImageURL} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800;900&family=Outfit:wght@400;500;700;900&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-black text-white">
    <!-- Custom Magic Cursor -->
    <div id="magic-cursor"></div>

    <!-- Navigation -->
    <nav class="fixed top-6 left-0 right-0 z-[100] px-4 md:px-8 max-w-[1100px] mx-auto w-full transition-all duration-300" id="site-nav">
      <div class="neo-panel flex items-center justify-between px-6 py-4 rounded-[32px]">
        <div class="flex items-center gap-4">
          <a href="/" class="font-heading text-xl font-bold tracking-tight text-white hover:text-[var(--color-cyan)] transition-colors" id="nav-home">
            SURYA RAGHURAM
          </a>
          <div class="hidden md:flex items-center gap-3 ml-4 border-l border-white/10 pl-4">
            <a
              href="https://github.com/suryaraghuramg"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-white transition-colors"
              aria-label="GitHub Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <a
              href="https://www.linkedin.com/in/surya-raghuramg"
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/60 hover:text-[#0a66c2] transition-colors"
              aria-label="LinkedIn Profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="social-icon"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
          </div>
        </div>
        <ul class="flex items-center gap-2 md:gap-4 m-0 p-0 list-none">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="neo-btn text-xs md:text-sm px-4 py-2"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>

    <!-- Main Content -->
    <main class="container-page pt-32 pb-24 min-h-[80vh]" id="main-content">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="mt-24 pb-12 px-6 max-w-[1100px] mx-auto w-full" id="site-footer">
      <div class="neo-panel p-8 rounded-[32px] flex flex-col md:flex-row justify-between items-center gap-6 text-sm text-white/60">
        <div class="flex flex-col items-center md:items-start gap-1">
          <span class="font-mono font-medium text-white">&copy; {new Date().getFullYear()} DURGA SURYA RAGHURAM GADEPALLI</span>
          <span class="font-mono text-xs opacity-70">LAST UPDATED: {new Date().toLocaleDateString('en-US', { month: 'short', year: 'numeric' }).toUpperCase()}</span>
        </div>
        
        <div class="text-center font-mono font-light text-xs">
          <span>BUILT WITH <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-[var(--color-cyan)] hover:text-white transition-colors underline decoration-dotted underline-offset-4 font-bold">ASTRO.JS</a></span>
        </div>

        <div class="flex items-center gap-3">
          <button id="footer-contact-trigger" class="neo-btn neo-btn--yellow text-xs px-4 py-2">CONTACT ME</button>
        </div>
      </div>
    </footer>

    <!-- Contact Modal -->
    <dialog id="contact-modal" class="fixed inset-0 m-auto bg-transparent p-0 w-full max-w-none h-full max-h-none overflow-visible z-[200] backdrop-blur-md backdrop-brightness-50" style="display: none;">
      <div class="neo-panel p-8 md:p-12 max-w-md mx-auto mt-[20vh] relative">
        <button id="close-modal-btn" class="absolute top-6 right-6 text-white/60 hover:text-white transition-colors" aria-label="Close modal">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        
        <div class="flex flex-col gap-6">
          <div class="border-b border-white/10 pb-4">
            <h2 class="text-2xl font-bold text-white mb-2">SAY HELLO!</h2>
            <p class="text-white/70 font-mono text-sm">Have a cool project or just want to chat? Drop me a line.</p>
          </div>
          
          <div class="flex flex-col gap-4">
            <div class="flex flex-col gap-2">
              <span class="font-mono text-xs font-bold text-white/50 tracking-wider">EMAIL</span>
              <div class="flex items-center justify-between bg-white/5 border border-white/10 p-4 rounded-xl">
                <a href="mailto:suryaraghuramg@gmail.com" class="font-mono text-sm font-medium text-white hover:text-[var(--color-cyan)] transition-colors email-link truncate">suryaraghuramg@gmail.com</a>
                <button id="copy-email-btn" class="neo-btn px-3 py-1 text-[10px]" title="Copy email">
                  <span id="copy-text">COPY</span>
                </button>
              </div>
            </div>
            
            <div class="flex flex-col gap-2">
              <span class="font-mono text-xs font-bold text-white/50 tracking-wider">PHONE</span>
              <div class="flex items-center justify-between bg-white/5 border border-white/10 p-4 rounded-xl">
                <a href="tel:+917676693964" class="font-mono text-sm font-medium text-white hover:text-[var(--color-cyan)] transition-colors">+91 7676693964</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Scroll Progress Line -->
    <div id="scroll-progress" class="fixed top-0 left-0 h-1 bg-[var(--color-cyan)] z-[200] transition-all duration-100 ease-out shadow-[0_0_10px_var(--color-cyan)]" style="width: 0%;"></div>

    <script>
      import pressSound from '../assets/press-sound.mp3';
      import clickSound from '../assets/click-sound.mp3';

      // Enable custom cursor styles only if JS loads and not on a mobile browser in normal view
      const isMobileUA = /Mobi|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
      if (!isMobileUA) {
        document.documentElement.classList.add('custom-cursor-active');
      }

      const magicCursor = document.getElementById('magic-cursor');

      // Click & Press sounds Web Audio API setup for zero-latency playback
      let pressBuffer: AudioBuffer | null = null;
      let clickBuffer: AudioBuffer | null = null;
      let audioCtx: AudioContext | null = null;

      const initAudio = async () => {
        if (pressBuffer && clickBuffer) return;
        try {
          const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
          audioCtx = new AudioContextClass();
          
          const loadBuffer = async (url: string): Promise<AudioBuffer | null> => {
            const response = await fetch(url);
            const arrayBuffer = await response.arrayBuffer();
            return new Promise<AudioBuffer>((resolve, reject) => {
              audioCtx!.decodeAudioData(arrayBuffer, resolve, reject);
            });
          };

          const [pBuf, cBuf] = await Promise.all([
            loadBuffer(pressSound).catch(() => null),
            loadBuffer(clickSound).catch(() => null)
          ]);

          pressBuffer = pBuf;
          clickBuffer = cBuf;
        } catch (err) {
          console.debug('Failed to preload click/press audio:', err);
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => { initAudio(); });
      } else {
        initAudio();
      }

      const playAudio = (type: 'press' | 'click') => {
        try {
          if (!audioCtx || !clickBuffer || !pressBuffer) {
            initAudio(); 
            return;
          }
          const buffer = type === 'click' ? clickBuffer : pressBuffer;
          if (!buffer) return;
          if (audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
          }
          const source = audioCtx.createBufferSource();
          source.buffer = buffer;
          const gainNode = audioCtx.createGain();
          gainNode.gain.value = type === 'click' ? 0.35 : 0.4;
          source.connect(gainNode);
          gainNode.connect(audioCtx.destination);
          source.start(0);
        } catch (err) {}
      };

      document.body.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;
        const link = target.closest('a') as HTMLAnchorElement | null;
        const isInteractive = target.closest('button, [role="button"], .neo-btn');

        if (isInteractive || link) {
          const isNavbar = target.closest('.site-nav');
          if (isNavbar) playAudio('click');
          else playAudio('press');
        }

        if (link) {
          const href = link.getAttribute('href');
          const targetAttr = link.getAttribute('target');
          const isSameOrigin = link.origin === window.location.origin;
          const isHashOnly = href && (href.startsWith('#') || (link.pathname === window.location.pathname && link.search === window.location.search && href.includes('#')));
          
          if (
            href && isSameOrigin && !isHashOnly && !href.startsWith('mailto:') && !href.startsWith('tel:') &&
            (!targetAttr || targetAttr === '_self') && !e.metaKey && !e.ctrlKey && !e.shiftKey && e.button === 0
          ) {
            e.preventDefault();
            setTimeout(() => { window.location.href = href; }, 120);
          }
        }
      });

      const updateMousePosition = (e: MouseEvent) => {
        document.documentElement.style.setProperty('--mouse-x', `${e.clientX}px`);
        document.documentElement.style.setProperty('--mouse-y', `${e.clientY}px`);
        if (magicCursor) {
          magicCursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0) translate(-50%, -50%)`;
        }
      };

      const updateTouchPosition = (e: TouchEvent) => {
        if (e.touches && e.touches[0]) {
          document.documentElement.style.setProperty('--mouse-x', `${e.touches[0].clientX}px`);
          document.documentElement.style.setProperty('--mouse-y', `${e.touches[0].clientY}px`);
        }
      };

      window.addEventListener('mousemove', updateMousePosition);
      window.addEventListener('touchmove', updateTouchPosition);

      const updateScrollProgress = () => {
        const currentScrollY = window.scrollY;
        const maxScrollY = document.documentElement.scrollHeight - window.innerHeight;
        const percent = maxScrollY > 0 ? (currentScrollY / maxScrollY) * 100 : 0;
        const progressLine = document.getElementById('scroll-progress');
        if (progressLine) progressLine.style.width = `${percent}%`;

        // Hide/Show navbar on scroll
        const nav = document.getElementById('site-nav');
        if (nav) {
          if (currentScrollY > 50) {
            nav.classList.add('bg-black/50', 'backdrop-blur-md', 'py-2');
          } else {
            nav.classList.remove('bg-black/50', 'backdrop-blur-md', 'py-2');
          }
        }
      };

      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      window.addEventListener('resize', updateScrollProgress, { passive: true });

      const initLensEffect = () => {
        const cursor = document.getElementById('magic-cursor');
        if (!cursor) return;
        
        document.body.addEventListener('mouseover', (e) => {
          const target = e.target as HTMLElement;
          if (!target) return;

          if (target.closest('.neo-btn, button, a')) {
            cursor.classList.remove('lens-active');
            cursor.classList.add('selector-active');
            return;
          } else {
            cursor.classList.remove('selector-active');
          }
          
          const isTextElement = target.closest('h1, h2, h3, h4, h5, h6, p, span, li, strong, em');
          if (isTextElement) {
            cursor.classList.add('lens-active');
          } else {
            cursor.classList.remove('lens-active');
          }
        });
      };

      const initContactModal = () => {
        const trigger = document.getElementById('footer-contact-trigger');
        const modal = document.getElementById('contact-modal') as HTMLDialogElement | null;
        const closeBtn = document.getElementById('close-modal-btn');
        const copyBtn = document.getElementById('copy-email-btn');
        const copyText = document.getElementById('copy-text');
        const emailLink = document.querySelector('.email-link') as HTMLAnchorElement | null;

        if (!modal || !trigger) return;

        const showModal = () => {
          modal.style.display = 'block';
          modal.showModal();
          if (magicCursor) modal.appendChild(magicCursor);
          document.body.style.overflow = 'hidden';
        };

        const closeModal = () => {
          modal.style.display = 'none';
          modal.close();
          if (magicCursor) document.body.appendChild(magicCursor);
          document.body.style.overflow = '';
        };

        trigger.addEventListener('click', showModal);
        closeBtn?.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeModal();
        });

        copyBtn?.addEventListener('click', () => {
          if (!emailLink) return;
          const email = emailLink.textContent || 'suryaraghuramg@gmail.com';
          navigator.clipboard.writeText(email).then(() => {
            if (copyText) {
              copyText.textContent = 'COPIED!';
              setTimeout(() => { copyText.textContent = 'COPY'; }, 2000);
            }
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initLensEffect();
          initContactModal();
        });
      } else {
        initLensEffect();
        initContactModal();
      }
    </script>
  </body>
</html>
